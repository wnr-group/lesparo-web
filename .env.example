# LESPARO — environment variables. Copy to .env.local for development.
# Never commit real values. Anything without NEXT_PUBLIC_ is SERVER-ONLY.

# --- Public (safe to expose to the browser) ---------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only ------------------------------------------------------------
# Database (Supabase Postgres). Copy both strings from the Supabase dashboard (Connect).
# DATABASE_URL: used by the app at runtime. DIRECT_URL: used by Prisma migrations.
DATABASE_URL=<your-database-connection-string>
DIRECT_URL=<your-direct-connection-string>
# File storage (Supabase Storage, same project): catalogue images and enquiry attachments.
# Project URL and the SECRET key (sb_secret_...) from Project Settings > API Keys. Create the buckets with `npm run storage:setup`.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
# Admin sign-in (Supabase Auth). The PUBLISHABLE key (sb_publishable_..., or the legacy anon key) from the same page.
# Used by server code only. The secret key above is never used by the sign-in code, only by `npm run staff:grant`.
# See docs/admin-auth.md for the dashboard settings (sign-ups off, email template, redirect URLs).
SUPABASE_PUBLISHABLE_KEY=
# Random string (32+ chars) used to hash client IPs for rate limiting.
RATE_LIMIT_SALT=
# Bearer token for GET /api/jobs/run (scheduled integration retries). Unset = route disabled.
CRON_SECRET=

# CRM: "none" until the business confirms a provider (see docs/integrations.md).
# "mock" is for local testing only and is refused in production.
CRM_PROVIDER=none
# Transactional email: "none" until a provider is confirmed. "mock" = local testing only.
EMAIL_PROVIDER=none
# Inbox that receives new-enquiry notifications once email is configured.
SALES_NOTIFICATION_EMAIL=

# --- Razorpay (online payment) ----------------------------------------------
# Dashboard > Account & Settings > API Keys. Use TEST keys (rzp_test_...) until test payments pass end to end.
# Online payment is switched off while either key is empty. See docs/razorpay.md.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when creating the webhook in the Razorpay Dashboard (any random 24+ characters).
RAZORPAY_WEBHOOK_SECRET=
