{
  "name": "lesparo-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "prisma migrate deploy && tsx scripts/import-catalogue.ts && tsx scripts/seed-admin.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "catalogue:crawl": "tsx scripts/crawl-live-catalogue.ts",
    "catalogue:import": "tsx --env-file=.env.local scripts/import-catalogue.ts",
    "staff:grant": "tsx --env-file=.env.local scripts/grant-staff-role.ts",
    "admin:seed": "tsx --env-file=.env.local scripts/seed-admin.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "prices:dummy": "tsx --env-file=.env.local scripts/seed-dummy-prices.ts",
    "db:seed": "npm run catalogue:import && npm run admin:seed && npm run prices:dummy",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "db:studio": "prisma studio",
    "jobs:run": "tsx --conditions=react-server --env-file=.env.local scripts/run-integration-jobs.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lenis": "1.3.26",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "cheerio": "^1.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "better-sqlite3@12.11.1": true
  }
}
