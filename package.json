{
  "name": "lesparo-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "catalogue:crawl": "tsx scripts/crawl-live-catalogue.ts",
    "catalogue:import": "tsx --env-file=.env.local scripts/import-catalogue.ts",
    "staff:grant": "tsx --env-file=.env.local scripts/grant-staff-role.ts",
    "jobs:run": "tsx --conditions=react-server --env-file=.env.local scripts/run-integration-jobs.ts",
    "test:security": "tsx --env-file=.env.local tests/security/rls.check.ts",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > types/database.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "lenis": "1.3.26",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
